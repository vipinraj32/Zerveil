# Copy to .env and fill in. Never commit .env.
# Required to use the app: GOOGLE_OAUTH_CLIENT_ID/_SECRET, SESSION_SECRET, YOUTUBE_API_KEY.
# Payments run in PAYMENT_MODE=simulated (no ZEC moves) until a Zcash wallet is configured below.

APP_NAME=Zerveil
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
# Where the browser lands after login. Dev with Vite: http://localhost:5173 ; empty = PUBLIC_BASE_URL
FRONTEND_URL=

# --- Sign-in: Google OAuth "Web application" client ---
# Authorized redirect URI: PUBLIC_BASE_URL + /auth/google/callback (e.g. http://localhost:8000/auth/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Long random string: signs session cookies, encrypts creators' agent keys and MACs agent authorizations.
# Never change it after users sign up. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Google accounts (comma-separated) with the read-only operator views (scanner status, invoices, payment events).
# Operators never hold, approve or send funds: Zerveil has no wallet that can spend.
ADMIN_EMAILS=
# Bearer token for the stdio MCP server (read-only operator view of all campaigns); empty disables it
MCP_API_TOKEN=

# --- PostgreSQL (app data + LangGraph checkpoints); empty = in-memory, lost on restart ---
DATABASE_URL=
# Store tests against a throwaway database (never production):
# TEST_DATABASE_URL=postgresql://zerveil:zerveil@localhost:5432/zerveil_test

# --- Verifier: YouTube Data API v3 key; required to verify posts ---
YOUTUBE_API_KEY=

# --- LLM (agents negotiate with Claude when set; deterministic strategies otherwise) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zerveil

# =====================================================================================================================
# Zcash payments — DIRECT, shielded, testnet. Zerveil never holds funds: there is no escrow, operator wallet or payout.
# Advertisers pay each creator directly to a fresh Unified Address of the creator's own wallet account. Zerveil only
# watches that account through the Unified Full Viewing Key (UFVK) the creator connected, which can see but not spend.
# =====================================================================================================================
#   simulated  in-process scanner stand-in: every invoice, note and receipt is labeled simulated and no TAZ moves.
#   zcash      real testnet scanning with zcash-devtool against a lightwalletd server. Refuses to start without
#              ZCASH_DEVTOOL_WALLET_DIR and the zcash-devtool binary. Never falls back to simulated.
PAYMENT_MODE=simulated
# Testnet only (TAZ — no real monetary value). PAYMENT_MODE=zcash refuses mainnet.
ZCASH_NETWORK=testnet
ZCASH_TESTNET_ENABLED=true

# Scanner backend: zcash-devtool is the only real backend (see README, "Wallet selection").
ZCASH_WALLET_BACKEND=zcash-devtool
# Public testnet lightwalletd (gRPC over TLS)
ZCASH_LIGHTWALLETD_URL=https://testnet.zec.rocks:443
# Path to a zcash-devtool binary built from its main branch (NU7 / Ironwood cohort)
ZCASH_DEVTOOL_BIN=zcash-devtool
# Directory of the VIEW-ONLY wallet that holds the imported viewing keys. Keep it private and out of git.
ZCASH_DEVTOOL_WALLET_DIR=
# Seconds one scanner call may take (the first sync after a key import can be long)
ZCASH_SCANNER_TIMEOUT_SECONDS=900
# The scheduler scans watched accounts for invoice payments
ZCASH_PAYMENT_SCANNER_ENABLED=true
# Receivers in each invoice's fresh Unified Address: shielded only (Orchard receivers are paid into Ironwood under NU7)
ZCASH_RECEIVER_TYPES=orchard,sapling
# Confirmations before a payment counts as confirmed (never less than 1; unconfirmed is never treated as paid)
ZCASH_CONFIRMATION_THRESHOLD=3
# How long a milestone invoice stays payable (a payment seen in time keeps confirming after expiry)
ZCASH_INVOICE_TTL_MINUTES=1440
# Optional transaction link template for receipts, e.g. https://<testnet explorer>/tx/{txid} ; empty = no links
ZCASH_EXPLORER_TX_URL=
# Shown in the UI; Zerveil never claims faucet funds itself
ZCASH_FAUCET_URL=https://zcash-faucet.vercel.app/

# Not used by the zcash-devtool backend (it talks to lightwalletd directly, no wallet RPC). Reserved for a future
# RPC-based scanner; leave empty.
ZCASH_WALLET_RPC_URL=
ZCASH_WALLET_AUTH_TOKEN=

# --- HTTP 402 payment-gated API: paid directly to the API seller's own wallet account ---
# UFVK (uviewtest1...) of the API seller's dedicated receiving account and its birthday height. Simulated mode uses a
# simulated seller account when empty; PAYMENT_MODE=zcash disables 402 payments until it is set.
ZCASH_API_SELLER_UFVK=
ZCASH_API_SELLER_BIRTHDAY=0
PREMIUM_SEARCH_PRICE=0.05
API_INVOICE_TTL_MINUTES=30

# --- Real-testnet integration tests (tests/test_zcash_live.py; skipped unless set). Read-only: nothing is sent. ---
# ZCASH_LIVE_DEVTOOL_BIN=
# ZCASH_LIVE_WALLET_DIR=
# ZCASH_LIVE_UFVK=
# ZCASH_LIVE_BIRTHDAY=
# ZCASH_LIVE_LIGHTWALLETD=https://testnet.zec.rocks:443
# ZCASH_LIVE_EXPECT_TXID=
