# Copy to .env and fill in. Never commit .env.
# Required to use the app: GOOGLE_OAUTH_CLIENT_ID/_SECRET, SESSION_SECRET, YOUTUBE_API_KEY.
# Payments run in PAYMENT_MODE=simulated (no ZEC moves) until a Zcash wallet is configured below.

APP_NAME=Zerveil
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
# Where the browser lands after login. Dev with Vite: http://localhost:5173 ; empty = PUBLIC_BASE_URL
FRONTEND_URL=

# --- Sign-in: Google OAuth "Web application" client ---
# Authorized redirect URI: PUBLIC_BASE_URL + /auth/google/callback (e.g. http://localhost:8000/auth/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Long random string: signs session cookies, encrypts creators' agent keys and MACs agent authorizations.
# Never change it after users sign up. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Google accounts (comma-separated) that may approve payouts and see the escrow custody view
ADMIN_EMAILS=
# Bearer token for the stdio MCP server (read-only operator view of all campaigns); empty disables it
MCP_API_TOKEN=

# --- PostgreSQL (app data + LangGraph checkpoints); empty = in-memory, lost on restart ---
DATABASE_URL=
# Store tests against a throwaway database (never production):
# TEST_DATABASE_URL=postgresql://zerveil:zerveil@localhost:5432/zerveil_test

# --- Verifier: YouTube Data API v3 key; required to verify posts ---
YOUTUBE_API_KEY=

# --- LLM (agents negotiate with Claude when set; deterministic strategies otherwise) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zerveil

# =====================================================================================================================
# Zcash payments
# =====================================================================================================================
#   simulated  in-process wallet stand-in: invoices, scanning and payouts run end to end, every record is labeled
#              simulated and no ZEC moves. The default.
#   zcash      a real Zcash wallet (Zallet, or a zcashd-compatible wallet) over JSON-RPC. Refuses to start unless
#              ZCASH_WALLET_RPC_URL, ZCASH_ESCROW_ACCOUNT and ZCASH_ESCROW_FROM_ADDRESS are set. Never falls back.
PAYMENT_MODE=simulated
# testnet (TAZ, no monetary value) | mainnet | regtest. This MVP is built and tested for testnet.
ZCASH_NETWORK=testnet

# Wallet JSON-RPC. Plain HTTP: keep it on 127.0.0.1, an SSH tunnel or a private network, never the public internet.
# Zallet's testnet RPC is configured in its zallet.toml ([rpc] bind); 28232 is zcashd's testnet default.
ZCASH_WALLET_RPC_URL=
ZCASH_WALLET_RPC_USER=
ZCASH_WALLET_RPC_PASSWORD=
# The escrow account in that wallet (Zallet: account UUID from z_listaccounts; zcashd: account number) and one of its
# Unified Addresses (utest1...), which payouts are sent from
ZCASH_ESCROW_ACCOUNT=
ZCASH_ESCROW_FROM_ADDRESS=
# Receivers in each invoice's fresh Unified Address: shielded only
ZCASH_RECEIVER_TYPES=orchard,sapling
# z_sendmany privacy policy for payouts
ZCASH_PRIVACY_POLICY=FullPrivacy
# Confirmations before an invoice counts as paid, and of the notes a payout may spend
ZCASH_CONFIRMATION_THRESHOLD=3
ZCASH_SEND_MINCONF=3
# How long funding and top-up invoices stay payable (a payment seen in time never expires while confirming)
ZCASH_INVOICE_TTL_MINUTES=120
# Added to each deal's funding to pay ZIP-317 fees for its payouts
ZCASH_FEE_RESERVE_PER_DEAL=0.0003
# Optional transaction link template for the UI, e.g. https://<testnet explorer>/tx/{txid} ; empty = no links
ZCASH_EXPLORER_TX_URL=

# Payouts wait for an operator in ADMIN_EMAILS before the wallet sends them (recommended)
PAYOUT_APPROVAL_REQUIRED=true
# A send whose result was lost is looked up in the wallet's outgoing memos after this many minutes
PAYOUT_RECONCILE_AFTER_MINUTES=10

# --- HTTP 402 payment-gated API ---
PREMIUM_SEARCH_PRICE=0.05
API_INVOICE_TTL_MINUTES=30

# --- Real-testnet integration tests (tests/test_zcash_live.py; skipped unless set) ---
# ZCASH_LIVE_RPC_URL=
# ZCASH_LIVE_RPC_USER=
# ZCASH_LIVE_RPC_PASSWORD=
# ZCASH_LIVE_ACCOUNT=
# ZCASH_LIVE_FROM_ADDRESS=
# ZCASH_LIVE_SEND=1
# ZCASH_LIVE_SEND_TO=
